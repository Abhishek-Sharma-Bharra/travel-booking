{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vashisht-travelos-api-staging",
  "main": "entry.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../../.open-next/assets", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "404-page" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vashisht-travelos-api-staging" }],
  "vars": {
    "TRAVELOS_RUNTIME": "cloudflare",
    "BETTER_AUTH_URL": "https://vashisht-travelos-staging.pages.dev",
    "PUBLIC_SITE_URL": "https://vashisht-travelos-staging.pages.dev",
    "SITE_INDEXING_ENABLED": "false", "HOTELS_ENABLED": "false",
    "WHATSAPP_LIVE_SEND_APPROVED": "false", "WHATSAPP_PROVISION_APPROVED": "false"
  }
}
