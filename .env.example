DATABASE_URL=postgresql://travelos:local-development-only@localhost:5432/travelos
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Configure email securely in the hosting provider before enabling verification.
# Gmail option: enable Google 2-step verification and create an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-own-email-address
# SMTP_PASS=enter-app-password-in-secret-settings
# MAIL_FROM=TravelOS <your-own-email-address>
# REQUIRE_EMAIL_VERIFICATION=true
# SUPPORT_EMAIL=your-own-support-email
# Alternative to SMTP: RESEND_API_KEY with a verified MAIL_FROM domain.
# Encrypted backup commands need a separate random 32+ character key:
# BACKUP_ENCRYPTION_KEY=enter-in-secret-settings-never-commit
# Verified operator email(s) allowed to manage manual subscriptions at /admin:
# PLATFORM_ADMIN_EMAILS=your-own-verified-email
# Keep owner credentials in the controlled migration job, not the web runtime:
# MIGRATION_DATABASE_URL=database-owner-url-in-release-job-only
# Role provisioning command (operator environment only):
# APP_DB_USER=travelos_app
# APP_DB_PASSWORD=random-32-plus-character-password-in-secure-settings

# Optional server-only extraction provider. Never use NEXT_PUBLIC_ for credentials.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
