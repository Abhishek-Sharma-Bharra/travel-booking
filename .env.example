DATABASE_URL=postgresql://travelos:local-development-only@localhost:5432/travelos
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Configure email securely in the hosting provider before enabling verification.
# Gmail option: enable Google 2-step verification and create an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-own-email-address
# SMTP_PASS=enter-app-password-in-secret-settings
# MAIL_FROM=TravelOS <your-own-email-address>
# REQUIRE_EMAIL_VERIFICATION=true
# SUPPORT_EMAIL=your-own-support-email
# Alternative to SMTP: RESEND_API_KEY with a verified MAIL_FROM domain.
# Encrypted backup commands need a separate random 32+ character key:
# BACKUP_ENCRYPTION_KEY=enter-in-secret-settings-never-commit
# Verified operator email(s) allowed to manage manual subscriptions at /admin:
# PLATFORM_ADMIN_EMAILS=your-own-verified-email
# Keep owner credentials in the controlled migration job, not the web runtime:
# MIGRATION_DATABASE_URL=database-owner-url-in-release-job-only
# Role provisioning command (operator environment only):
# APP_DB_USER=travelos_app
# APP_DB_PASSWORD=random-32-plus-character-password-in-secure-settings

# Optional server-only extraction provider. Never use NEXT_PUBLIC_ for credentials.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Integration credential vault: JSON version -> 32-byte hex key; server only.
INTEGRATION_ACTIVE_KEY=
INTEGRATION_ENCRYPTION_KEYS=
META_APP_ID=
META_APP_SECRET=
# Select an explicitly supported version from current provider documentation.
META_GRAPH_VERSION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=

# Official WhatsApp: operator provisioning only, disabled by default.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PROVISION_APPROVED=false
WHATSAPP_LIVE_SEND_APPROVED=false
# WHATSAPP_ACCESS_TOKEN belongs only in the operator provisioning environment.
# Separate 32+ random characters for a private scheduled runner, never NEXT_PUBLIC.
AUTOMATION_RUNNER_SECRET=

# Public SEO configuration. Canonicals/sitemap must use the actual primary HTTPS origin.
PUBLIC_SITE_URL=https://vashisht-travelos.onrender.com
# Set false on private staging/preview environments (rebuild after changing).
SITE_INDEXING_ENABLED=true
# Public contact authorized by the owner; independent of SMTP authentication.
PUBLIC_CONTACT_EMAIL=avinav.vashisht@gmail.com
# Optional public verification token from Google Search Console, not a password/API key.
# GOOGLE_SITE_VERIFICATION=
