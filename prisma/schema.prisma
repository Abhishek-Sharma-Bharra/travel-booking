generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Agency {
  id String @id @default(cuid())
  name String
  logo String @default("")
  contact String @default("")
  footer String @default("Thank you for choosing us. Prices are subject to availability.")
  plan String @default("Starter")
  subscription String @default("Trial")
  demo Boolean @default(false)
  trialEndsAt DateTime @default(dbgenerated("(now() + interval '14 days')"))
  subscriptionExpiresAt DateTime?
  invitations Invitation[]
  createdAt DateTime @default(now())
  users User[]
  leads Lead[]
  packages Package[]
  quotes Quote[]
  bookings Booking[]
  transactions Transaction[]
  activities Activity[]
  spends Spend[]
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agencyId String?
  role String @default("OWNER")
  disabled Boolean @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactors TwoFactor[]
  agency Agency? @relation(fields:[agencyId], references:[id])
  sessions Session[]
  accounts Account[]
  leads Lead[]
  @@unique([id,agencyId])
}
model Session {
  mfaVerifiedAt DateTime?
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model Lead {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  externalId String
  customer String
  email String @default("")
  phone String @default("")
  destination String
  enquiryDate DateTime @default(now())
  travelStart DateTime
  travelEnd DateTime
  travellers Int
  budget Int
  quotedPrice Int @default(0)
  source String
  assignedId String
  assigned User @relation(fields:[assignedId,agencyId],references:[id,agencyId],onUpdate:Restrict,onDelete:Restrict)
  stage String @default("New")
  notes String @default("")
  lostReason String @default("")
  followUp DateTime?
  firstResponseHours Float?
  repeatCustomer Boolean?
  itineraryRequested Boolean?
  score Float?
  scoreReason String @default("Not scored: required inputs missing")
  modelVersion String?
  scoredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes Quote[]
  booking Booking?
  activities Activity[]
  @@unique([id,agencyId])
  @@unique([agencyId,externalId])
  @@index([agencyId,assignedId,enquiryDate])
}
model Package {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  name String
  destination String
  days Int
  inclusions String
  exclusions String
  price Int
  estimatedCost Int
  quotes Quote[]
  @@unique([id,agencyId])
  @@index([agencyId])
}
model Quote {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  leadId String
  lead Lead @relation(fields:[leadId,agencyId],references:[id,agencyId],onUpdate:Restrict,onDelete:Restrict)
  packageId String
  package Package @relation(fields:[packageId,agencyId],references:[id,agencyId],onUpdate:Restrict,onDelete:Restrict)
  travellers Int
  unitPrice Int
  travelStart DateTime
  travelEnd DateTime
  packageName String
  destination String
  duration Int
  inclusions String
  exclusions String
  discount Int
  taxBps Int
  total Int
  estimatedCost Int
  status String @default("Draft")
  createdAt DateTime @default(now())
  booking Booking?
  @@unique([id,leadId,agencyId])
  @@index([agencyId])
}
model Booking {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  leadId String @unique
  lead Lead @relation(fields:[leadId,agencyId],references:[id,agencyId],onUpdate:Restrict,onDelete:Restrict)
  quoteId String @unique
  quote Quote @relation(fields:[quoteId,leadId,agencyId],references:[id,leadId,agencyId],onUpdate:Restrict,onDelete:Restrict)
  total Int
  cancellationFee Int @default(0)
  status String @default("Confirmed")
  supplierStatus String @default("Pending")
  dueDate DateTime
  travelStart DateTime
  travelEnd DateTime
  createdAt DateTime @default(now())
  transactions Transaction[]
  @@unique([leadId,agencyId])
  @@unique([quoteId,leadId,agencyId])
  @@unique([id,agencyId])
  @@index([agencyId])
}
model Transaction {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  bookingId String
  booking Booking @relation(fields:[bookingId,agencyId],references:[id,agencyId],onUpdate:Restrict,onDelete:Restrict)
  requestId String?
  requestHash String?
  kind String
  amount Int
  supplier String @default("")
  memo String @default("")
  date DateTime @default(now())
  dueDate DateTime?
  createdAt DateTime @default(now())
  @@unique([agencyId,requestId])
  @@index([agencyId,bookingId])
}
model Activity {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  leadId String?
  lead Lead? @relation(fields:[leadId,agencyId],references:[id,agencyId],onUpdate:Restrict,onDelete:Restrict)
  actor String
  action String
  createdAt DateTime @default(now())
  @@index([agencyId])
}
model Spend {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  month String
  kind String
  channel String
  amount Int
  memo String @default("")
  @@unique([agencyId,month,kind,channel])
}

model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
model RequestBucket {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}
model Invitation {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields:[agencyId],references:[id])
  email String
  role String
  tokenHash String @unique
  status String @default("Pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  @@index([agencyId,email,status])
}

model TwoFactor {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  secret String
  backupCodes String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  @@index([userId])
  @@index([secret])
}
