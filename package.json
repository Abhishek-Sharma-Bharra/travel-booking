{
  "name": "vashisht-travelos",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:generate": "tsx scripts/generate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "ml:train": "python3 ml/train.py",
    "test:e2e": "playwright test",
    "db:start": "bash scripts/dev-db.sh",
    "db:backup": "bash scripts/backup.sh",
    "subscription": "tsx scripts/subscription.ts",
    "check:launch": "tsx scripts/readiness.ts",
    "agency:list": "tsx scripts/agencies.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "backup:secure": "tsx scripts/secure-backup.ts create",
    "backup:verify": "tsx scripts/secure-backup.ts verify",
    "backup:restore-test": "tsx scripts/secure-backup.ts restore-test",
    "whatsapp:provision": "tsx scripts/provision-whatsapp.ts",
    "mail:check": "tsx scripts/mail-check.ts",
    "db:provision-runtime": "tsx scripts/provision-runtime-role.ts",
    "automation:run": "tsx scripts/automation.ts",
    "test:migrations": "tsx scripts/rehearse-render-upgrade.ts",
    "test:load": "tsx scripts/load-smoke.ts",
    "cloudflare:build": "node scripts/cloudflare/build.mjs",
    "cloudflare:deploy:worker": "wrangler deploy -c cloudflare/worker/wrangler.jsonc",
    "cloudflare:deploy:pages": "wrangler pages deploy cloudflare/pages-dist --project-name travel-booking --branch main",
    "cloudflare:local-env": "node scripts/cloudflare/local-env.mjs",
    "cloudflare:dev:worker": "wrangler dev -c cloudflare/worker/wrangler.jsonc --port 8787 --persist-to .local/cloudflare-state",
    "cloudflare:dev:pages": "wrangler pages dev --port 3000 --service TRAVELOS_BACKEND=vashisht-travelos-api-staging",
    "d1:schema": "tsx scripts/cloudflare/d1-schema.ts",
    "d1:schema:check": "tsx scripts/cloudflare/d1-schema.ts --check",
    "d1:migrate:local": "wrangler d1 migrations apply TRAVELOS_DB --local --config cloudflare/worker/wrangler.jsonc --persist-to .local/cloudflare-state",
    "d1:migrate:remote": "wrangler d1 migrations apply TRAVELOS_DB --remote --config cloudflare/d1/wrangler.jsonc",
    "cloudflare:local-env:d1": "node scripts/cloudflare/local-env.mjs --d1",
    "d1:demo:prepare": "tsx scripts/cloudflare/d1-demo.ts",
    "d1:demo:local": "npm run d1:demo:prepare && wrangler d1 execute TRAVELOS_DB --local --config cloudflare/worker/wrangler.jsonc --persist-to .local/cloudflare-state --file .local/d1-demo.sql",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "cloudflare:release:worker": "node scripts/cloudflare/release-worker.mjs",
    "cloudflare:smoke:local": "node scripts/cloudflare/smoke-local.mjs"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@travelos/d1-client": "file:packages/d1-client",
    "better-auth": "1.7.12",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "nodemailer": "^10.2.1",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "^1.58.2",
    "@prisma/client-generator-js": "^7.10.1",
    "@prisma/internals": "^7.10.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261113.0-beta",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "rclone.js": "0.6.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
